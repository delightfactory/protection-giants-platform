NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
NEXT_PUBLIC_SITE_URL=https://your-production-host.example

# Cube L Web Push runtime. Generate one VAPID key pair and keep the private key server-only.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=your_server_only_vapid_private_key
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
PUSH_WORKER_SECRET=replace_with_a_random_server_only_secret_at_least_32_chars

# Local Supabase CLI / legacy fallback only:
# SUPABASE_SERVICE_ROLE_KEY=your_local_or_legacy_service_role_key
